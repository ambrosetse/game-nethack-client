extends RefCounted
## Translation of core (NetHack-generated) text, in GDScript.
##
## The same algorithm as native/bridge/core_text.cpp on the same rows
## (res://locale/core_text.json, generated by tools/build_core_text.py from
## tools/core_text_table.txt).  GameSession uses the native translator when
## the extension is loaded and this one otherwise; keep the two in step.
##
## Strings not in the table, and every string in English, come back unchanged.

const TABLE_PATH := "res://locale/core_text.json"
const LANGS := ["zh_TW", "zh_CN", "ko", "ja"]
const KO := 2
const POSSESSIVE := ["的", "的", "의", "の"]

static var _loaded := false
static var _rows: Array = []
## english -> row index
static var _exact := {}
## [{row, segs}] in table order; a seg is {cap: bool, text, num, tr}
static var _patterns: Array = []


## Index of `lang` in the table, or -1 when it is not translated.
static func lang_index(lang: String) -> int:
	return LANGS.find(lang)


## `text` in `lang`, or `text` itself when nothing matches.
static func translate(text: String, lang: String) -> String:
	var li := lang_index(lang)
	if text.is_empty() or li < 0:
		return text
	_load()
	if not "\n" in text:
		var r = _line(text, li)
		return text if r == null else r
	var lines := text.split("\n")
	var out := PackedStringArray()
	var i := 0
	while i < lines.size():
		if _normalise(lines[i]).is_empty():
			out.append(lines[i])
			i += 1
			continue
		var j := i
		var para := ""
		while j < lines.size() and not _normalise(lines[j]).is_empty():
			para += lines[j] + " "
			j += 1
		var whole = _line(_normalise(para), li) if j - i > 1 else null
		if whole != null:
			var first: String = lines[i]
			var indent := first.length() - first.lstrip(" \t\r\f\v").length()
			out.append(first.substr(0, indent) + whole)
		else:
			for k in range(i, j):
				var t = _line(lines[k], li)
				out.append(lines[k] if t == null else t)
		i = j
	return "\n".join(out)


static func _load() -> void:
	if _loaded:
		return
	_loaded = true
	var raw := FileAccess.get_file_as_string(TABLE_PATH)
	var data = JSON.parse_string(raw) if not raw.is_empty() else null
	if typeof(data) != TYPE_DICTIONARY:
		push_warning("core text table missing: " + TABLE_PATH)
		return
	_rows = data.get("rows", [])
	for i in _rows.size():
		var en: String = _rows[i][0]
		var segs := _parse(en)
		var pattern := false
		for s in segs:
			pattern = pattern or s.cap
		if pattern:
			_patterns.append({"row": i, "segs": segs})
		elif not _exact.has(en):
			_exact[en] = i


static func _parse(s: String) -> Array:
	var out := []
	var lit := ""
	var i := 0
	while i < s.length():
		if s[i] == "{":
			var j := i + 1
			var num := 0
			var digits := false
			while j < s.length() and s[j] >= "0" and s[j] <= "9":
				num = num * 10 + int(s[j])
				j += 1
				digits = true
			var tr := false
			if digits and j + 1 < s.length() and s[j] == ":" and s[j + 1] == "t":
				tr = true
				j += 2
			if digits and j < s.length() and s[j] == "}":
				if not lit.is_empty():
					out.append({"cap": false, "text": lit, "num": 0, "tr": false})
				lit = ""
				out.append({"cap": true, "text": "", "num": num, "tr": tr})
				i = j + 1
				continue
		lit += s[i]
		i += 1
	if not lit.is_empty():
		out.append({"cap": false, "text": lit, "num": 0, "tr": false})
	return out


static func _is_space(c: String) -> bool:
	return c == " " or c == "\t" or c == "\n" or c == "\r" or c == "\f" or c == "\v"


static func _normalise(s: String) -> String:
	var out := ""
	var pending := false
	for c in s:
		if _is_space(c):
			pending = not out.is_empty()
		else:
			if pending:
				out += " "
			pending = false
			out += c
	return out


static func _row_text(row: int, li: int) -> String:
	return _rows[row][li + 1]


## exact, collapsed-whitespace and first-letter case swapped lookups; null
## when not found
static func _lookup(s: String, li: int) -> Variant:
	var row: int = _exact.get(s, -1)
	if row < 0:
		var n := _normalise(s)
		row = _exact.get(n, -1)
		if row < 0 and not n.is_empty():
			var c := n.unicode_at(0)
			var swapped := ""
			if c >= 65 and c <= 90:
				swapped = n[0].to_lower()
			elif c >= 97 and c <= 122:
				swapped = n[0].to_upper()
			if not swapped.is_empty():
				row = _exact.get(swapped + n.substr(1), -1)
	return null if row < 0 else _row_text(row, li)


## A {n:t} capture: whole, else word by word; null if any word is unknown.
static func _capture(cap: String, li: int) -> Variant:
	var whole = _lookup(cap, li)
	if whole != null:
		return whole
	var cjk := li != KO
	var result := ""
	var any := false
	for word in cap.split(" ", false):
		var tail := ""
		if word.length() > 1 and word.ends_with(","):
			word = word.substr(0, word.length() - 1)
			tail = "、" if cjk else ","
		if word.length() > 2 and word.ends_with("'s"):
			word = word.substr(0, word.length() - 2)
			tail = POSSESSIVE[li] + tail
		var w = _lookup(word, li)
		if w == null:
			return null
		if any and not cjk:
			result += " "
		result += w + tail
		any = true
	return result if any else null


## Non-greedy backtracking match of segs[k..] against s from pos.
static func _match(segs: Array, k: int, s: String, pos: int, caps: Dictionary) -> bool:
	if k == segs.size():
		return pos == s.length()
	var seg: Dictionary = segs[k]
	if not seg.cap:
		var lit: String = seg.text
		if s.substr(pos, lit.length()) != lit:
			return false
		return _match(segs, k + 1, s, pos + lit.length(), caps)
	if pos >= s.length():
		return false
	if k + 1 == segs.size():
		caps[seg.num] = s.substr(pos)
		return true
	var next: String = segs[k + 1].text
	var at := s.find(next, pos + 1)
	while at >= 0:
		caps[seg.num] = s.substr(pos, at - pos)
		if _match(segs, k + 1, s, at, caps):
			return true
		at = s.find(next, at + 1)
	return false


static func _patterns_match(s: String, li: int) -> Variant:
	for p in _patterns:
		var segs: Array = p.segs
		var ok := true
		for seg in segs:
			ok = ok and seg.num < 16
		var caps := {}
		if not ok or not _match(segs, 0, s, 0, caps):
			continue
		var trans := {}
		for seg in segs:
			if seg.cap and seg.tr:
				trans[seg.num] = true
		var result := ""
		for seg in _parse(_row_text(p.row, li)):
			if not seg.cap:
				result += seg.text
			elif seg.num < 16:
				var v: String = caps.get(seg.num, "")
				if trans.has(seg.num):
					var t = _capture(v, li)
					if t != null:
						v = t
				result += v
		return result
	return null


## Split a trailing " [abc]" and/or " (y)" choice suffix: [body, suffix].
static func _split_suffix(s: String) -> Array:
	var body := s
	var suffix := ""
	for _round in 2:
		var end := body.length()
		while end > 0 and _is_space(body[end - 1]):
			end -= 1
		if end == 0:
			break
		var close := body[end - 1]
		var open := "[" if close == "]" else ("(" if close == ")" else "")
		if open.is_empty():
			break
		var start := body.rfind(open, end - 1)
		if start <= 0 or body[start - 1] != " ":
			break
		# "(y)" defaults are short; longer parentheses are part of the text
		if open == "(" and end - start > 5:
			break
		var cut := start - 1
		while cut > 0 and _is_space(body[cut - 1]):
			cut -= 1
		suffix = body.substr(cut) + suffix
		body = body.substr(0, cut)
	return [body, suffix]


## One line, or null when nothing was found.
static func _line(line: String, li: int) -> Variant:
	var a := 0
	var b := line.length()
	while a < b and _is_space(line[a]):
		a += 1
	while b > a and _is_space(line[b - 1]):
		b -= 1
	if a == b:
		return null
	var core := line.substr(a, b - a)
	var parts := _split_suffix(core)
	var body: String = parts[0]
	var suffix: String = parts[1]
	if body.is_empty():
		body = core
		suffix = ""
	var t = _lookup(body, li)
	if t == null:
		t = _patterns_match(_normalise(body), li)
	if t == null:
		return null
	return line.substr(0, a) + t + suffix + line.substr(b)
