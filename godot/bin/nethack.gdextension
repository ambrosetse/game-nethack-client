[configuration]

entry_symbol = "nethack_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

macos.debug = "res://bin/libnethack.macos.template_debug.framework"
macos.release = "res://bin/libnethack.macos.template_release.framework"
windows.debug.x86_64 = "res://bin/libnethack.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libnethack.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libnethack.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libnethack.linux.template_release.x86_64.so"
